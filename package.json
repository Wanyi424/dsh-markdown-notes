{
  "name": "dsh-markdown-notes",
  "version": "0.5.4",
  "description": "简单的 Markdown 笔记：多文档、编辑预览、本地自动保存。",
  "type": "module",
  "license": "MIT",
  "author": "Wanyi424",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wanyi424/dsh-markdown-notes.git"
  },
  "homepage": "https://github.com/Wanyi424/dsh-markdown-notes#readme",
  "bugs": {
    "url": "https://github.com/Wanyi424/dsh-markdown-notes/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": "^0.2.0-rc.2"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "licenses"
  ],
  "scripts": {
    "generate": "node scripts/build-sample.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pack:plugin": "npm run build && npm run typecheck && npm test && npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "devDependencies": {
    "@antv/infographic": "^0.2.20",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@iconify-json/mdi": "^1.2.3",
    "@lezer/highlight": "^1.2.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.17",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "markdown-it": "^14.3.2",
    "markdown-it-container": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.2.0",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
